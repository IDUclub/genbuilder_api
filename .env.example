# Non-sensitive application settings (GitHub Actions variable ENV_APP)
LOG_FILE=genbuilder_logs
PROMETHEUS_PORT=9464
UrbanDB_SOURCE=OSM
UrbanDB_YEAR=2024
AUTH_VERIFY=true
CHAT_MODEL=
# Non-zero priorities require vllm serve --scheduling-policy priority.
# Parameter extraction, zone mapping and chat titles: live-long/blocking or live/semi-blocking.
VLLM_REQUEST_PRIORITY=-60
# User-facing result summaries: live/blocking.
VLLM_CHAT_PRIORITY=-100
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SCOPE=
FILESERVER_BUCKET_NAME=
FILESERVER_SECURE=true
FILESERVER_REGION=us-east-1
OUTPUTS_DIR=outputs

# Service addresses (GitHub Actions variable ENV_URLS)
UrbanDB_API=https://urban-api.example.com
ChatStorage_API=
VLLM_BASE_URL=
A2A_PUBLIC_URL=http://localhost:8200
KEYCLOAK_URL=
FILESERVER_ENDPOINT=

# Credentials (GitHub Actions secret ENV_SECRET)
KEYCLOAK_CLIENT_SECRET=
FILESERVER_ACCESS_KEY=
FILESERVER_SECRET_KEY=
ADMIN_API_TOKEN=

# Runtime override infrastructure (normally keep these defaults)
RUNTIME_CONFIG_PATH=/runtime-config/overrides.sqlite3
RUNTIME_CONFIG_SYNC_TTL_SECONDS=5
